{
  "expo": {
    "name": "peekscan-app",
    "slug": "peekscan-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peekscan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PeekScan needs access to your camera to scan barcodes through seals."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.peekscan.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "PeekScan needs access to your camera to scan barcodes through seals."
        }
      ],
      "react-native-worklets-core",
      "react-native-reanimated"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
